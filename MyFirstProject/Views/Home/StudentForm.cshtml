
<html>
    <head>
        <style>
                    body {
            background-color: #0b1a2f;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Form Container */
        .s-form {
            width: 350px;
            margin: 60px auto;
            padding: 25px;
            background: #0f2747;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(0, 123, 255, 0.5);
            color: white;
        }

        /* Heading */
        .s-form h3 {
            text-align: center;
            color: #4fc3f7;
            margin-bottom: 20px;
        }

        /* Labels */
        .s-form label {
            font-weight: 500;
            margin-top: 10px;
            display: block;
        }

        /* Inputs & Select */
        .s-form input,
        .s-form select {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            margin-bottom: 12px;
            border: none;
            border-radius: 6px;
            outline: none;
            background-color: #1e3a5f;
            color: white;
        }

        /* Input Focus Effect */
        .s-form input:focus,
        .s-form select:focus {
            border: 1px solid #4fc3f7;
            box-shadow: 0 0 5px #4fc3f7;
        }

        /* Button */
        .s-form button {
            width: 100%;
            padding: 10px;
            background: #4fc3f7;
            border: none;
            border-radius: 6px;
            color: black;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        /* Button Hover */
        .s-form button:hover {
            background: #29b6f6;
        }
        </style>
    </head>
    <body> 
    <form class="s-form" action="/Home/StudentProfile" method="post">
        <h3>Student Form</h3>
        <div><label>Student-Name</label></div>
        <div> <input required type="text" name="sname" /></div>

        <div><label>Student-Id</label></div>
        <div> <input required type="number" name="sid" /></div>

        <div><label>Student-class</label></div>
        <div> <input required type="text" name="sclass" /></div>

        <div><label>Student-address</label></div>
        <div> <input required type="text" name="saddress" /></div>

        <div><label>Student-gender</label></div>
        <div> 
          <select name="sgen">
              <option value="Male">Male</option>
              <option value="Female">Female</option>
                <option value="Other">Other</option>
          </select>
        </div>
        <div>
            <button type="submit">Submit</button>
        </div>
    </form>
    </body>
</html>